        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="5.1 Ver mi mano (hector_eval, jugador actual)" enabled="true">
          <stringProp name="HTTPSampler.path">/api/games/hand?game_id=${gameId_flow}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="auth hector" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">authorization</stringProp>
                <stringProp name="Header.value">${token_creator}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Elegir jugada: play o draw (misma regla que cardMatchesTop)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
import groovy.json.JsonSlurper

def slurper = new JsonSlurper()
def handResp = slurper.parseText(prev.getResponseDataAsString())
def hand = handResp.hand
def top = slurper.parseText(vars.get(&quot;topCardJson&quot;)).top_card

def matches = { card, topCard -&gt;
  if (topCard == null) return true
  if (card.color == &quot;wild&quot;) return true
  if (card.color == topCard.color) return true
  if (card.type == topCard.type &amp;&amp; card.type != &quot;number&quot;) return true
  if (card.type == &quot;number&quot; &amp;&amp; topCard.type == &quot;number&quot; &amp;&amp; card.value == topCard.value) return true
  return false
}

def jugable = hand.find { c -&gt; matches(c, top) }

if (jugable != null) {
  vars.put(&quot;play_action&quot;, &quot;play&quot;)
  vars.put(&quot;chosenCardId&quot;, jugable.id.toString())
  vars.put(&quot;declaredColor&quot;, jugable.color == &quot;wild&quot; ? &quot;red&quot; : jugable.color)
} else {
  vars.put(&quot;play_action&quot;, &quot;draw&quot;)
}
log.info(&quot;evaluacion-final JMeter: accion elegida = &quot; + vars.get(&quot;play_action&quot;))
</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
          </JSR223PostProcessor>
